{
  "name": "moltek",
  "version": "0.1.0",
  "description": "An AI music studio. Ask for a track and the agent writes it, plays it, listens back to what came out, and mixes it.",
  "license": "AGPL-3.0-or-later",
  "author": "wayzeek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayzeek/moltek.git"
  },
  "homepage": "https://github.com/wayzeek/moltek#readme",
  "bugs": "https://github.com/wayzeek/moltek/issues",
  "keywords": [
    "strudel",
    "live-coding",
    "algorave",
    "music",
    "tidalcycles",
    "web-audio",
    "claude-code",
    "agent",
    "rest-api",
    "ai"
  ],
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/themes.mjs && next build",
    "start": "next start",
    "themes": "node scripts/themes.mjs",
    "push": "node scripts/push.mjs",
    "check": "node scripts/check.mjs",
    "listen": "node scripts/listen.mjs",
    "analyze": "node scripts/analyze.mjs",
    "share": "node scripts/share.mjs",
    "smoke": "node scripts/smoke.mjs",
    "validate:tracks": "node scripts/validate-tracks.mjs",
    "selftest": "node scripts/selftest.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@strudel/repl": "1.3.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
